# .env.example — Athena environment variables and secret references (I-07)
#
# Copy this file to .env and provide your secret values.
# NEVER commit .env to version control.

# PostgreSQL connection string (asyncpg driver)
ATHENA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/athena

# Root path for the Obsidian vault
ATHENA_VAULT_ROOT=/vault

# Cryptographic secret for signing session cookies (generate with `openssl rand -hex 32`)
ATHENA_SESSION_SECRET=

# OpenRouter API key for LLM access (obtain from https://openrouter.ai/keys)
ATHENA_OPENROUTER_API_KEY=

# iCloud app-specific password (generate at https://appleid.apple.com)
ATHENA_ICLOUD_APP_PASSWORD=

# Canvas LMS personal access token (generate under Canvas -> Account -> Settings)
ATHENA_CANVAS_TOKEN=

# Web Push VAPID keys (generate with web-push CLI or library)
ATHENA_VAPID_PUBLIC_KEY=
ATHENA_VAPID_PRIVATE_KEY=
